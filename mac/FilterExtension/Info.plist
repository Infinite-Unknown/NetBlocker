<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>NetBlocker Filter</string>
    <key>CFBundlePackageType</key>
    <string>SYSX</string>
    <key>NetworkExtension</key>
    <dict>
        <!-- Tells macOS which class implements the content-filter data provider.
             $(PRODUCT_MODULE_NAME) resolves to the extension target's Swift module. -->
        <key>NEProviderClasses</key>
        <dict>
            <key>com.apple.networkextension.filter-data</key>
            <string>$(PRODUCT_MODULE_NAME).FilterDataProvider</string>
        </dict>
    </dict>
</dict>
</plist>
